{
	"name": "purchase-cheaptest-games",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"engine": "pnpm --filter @psg/engine dev",
