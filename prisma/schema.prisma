generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "windows"]
}

datasource db {
    provider = "sqlite"
    url      = "file:./db.sqlite"
}

model Account {
    id Int @id @unique @default(autoincrement())

    username     String @unique
    accessToken  String
    refreshToken String

    limit            String @default("0")
    usage            String @default("max")
    maxPrice         Float  @default(0)
    priceOptionsFlag Int    @default(0)
    mode             String @default("buy")

    @@index([id])
}

model App {
    id Int @id

    name            String
    subId           Int
    snr             String
    originatingSnr  String
    price           Float
    limited         Boolean     @default(false)
    hasTradingCards Boolean     @default(false)
    isBundle        Boolean     @default(false)
    includedApps    BundleApp[]

    @@index([id])
}

model BundleApp {
    bundleId Int @id
    appId    Int

    bundle App @relation(fields: [bundleId], references: [id])

    @@index([bundleId])
}

model ActivatedKey {
    id Int @id @unique @default(autoincrement())

    productKey  String   @unique
    accountId   Int
    activatedAt DateTime @default(now())
    success     Boolean
    packageId   String?
    errorMessage String?

    @@index([productKey])
    @@index([accountId])
}

model ItemNameId {
    id Int @id @unique @default(autoincrement())

    appId          Int
    marketHashName String
    nameId         String
    createdAt      DateTime @default(now())

    @@unique([appId, marketHashName])
    @@index([appId, marketHashName])
}
