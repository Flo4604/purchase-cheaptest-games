{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".output/**", ".tanstack/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"PORT",
				"WS_PORT",
				"JOB_CONCURRENCY",
				"ENGINE_URL",
				"ENGINE_WS_URL",
				"NODE_ENV"
			]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"test": {
			"dependsOn": ["^build"]
		}
	}
}
